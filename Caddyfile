{
	admin off
	auto_https off
}

# TLS terminates at the edge (Cloudflare Tunnel / reverse proxy), so plain :80 here.
:80 {
	encode zstd gzip

	# Secrets Manager API -> our backend. The prefix is stripped, so the backend sees its normal
	# /api and /identity (which lets bws point at this same origin under /sm-api, too).
	handle_path /sm-api/* {
		reverse_proxy {$VAULTWARDEN_SM_URL:http://vaultwarden-sm:8080}
	}

	# Base vault traffic -> the companion vaultwarden (its API, login, notifications, icons, …).
	# `/admin` is vaultwarden's own admin panel (served by the backend when ADMIN_TOKEN is set), and
	# `/vw_static/*` is the admin panel's own CSS/JS/images. The rest are files vaultwarden renders
	# itself rather than serves from the web vault folder: `/css/vaultwarden.css` (its UI tweaks,
	# e.g. hiding the SSO email field on the login page), `/app-id.json` and
	# `/.well-known/apple-app-site-association` (FIDO / iOS app trust), and the `/alive` healthcheck.
	# None is part of the web vault build, so all must be proxied rather than fall through to the
	# static file server.
	@base path /api/* /identity/* /notifications/* /icons/* /attachments/* /events/* /admin /admin/* /vw_static/* /css/vaultwarden.css /app-id.json /.well-known/apple-app-site-association /alive
	handle @base {
		reverse_proxy {$VAULTWARDEN_URL:http://vaultwarden:80}
	}

	# Our static web vault (single-page app, hash routing). A missing file returns a clean 404 —
	# never the HTML shell — so an edge cache can't pin HTML under a .js/.css URL across deploys.
	# The HTML shell itself must never be cached stale; content-hashed assets are safe to cache.
	handle {
		root * /srv
		@html path / /index.html
		header @html Cache-Control "no-cache"
		file_server
	}
}
