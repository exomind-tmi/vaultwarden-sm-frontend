{
	admin off
	auto_https off
}

# TLS terminates at the edge (Cloudflare Tunnel / reverse proxy), so plain :80 here.
:80 {
	encode zstd gzip

	# Secrets Manager API -> our backend. The prefix is stripped, so the backend sees its normal
	# /api and /identity (which lets bws point at this same origin under /sm-api, too).
	handle_path /sm-api/* {
		reverse_proxy {$VAULTWARDEN_SM_URL:http://vaultwarden-sm:8080}
	}

	# Base vault traffic -> the companion vaultwarden (its API, login, notifications, icons, …).
	# `/admin` is vaultwarden's own admin panel (served by the backend when ADMIN_TOKEN is set); it
	# is not part of the web vault SPA, so it must be proxied too rather than fall through to static.
	@base path /api/* /identity/* /notifications/* /icons/* /attachments/* /events/* /admin /admin/*
	handle @base {
		reverse_proxy {$VAULTWARDEN_URL:http://vaultwarden:80}
	}

	# Our static web vault (single-page app, hash routing). A missing file returns a clean 404 —
	# never the HTML shell — so an edge cache can't pin HTML under a .js/.css URL across deploys.
	# The HTML shell itself must never be cached stale; content-hashed assets are safe to cache.
	handle {
		root * /srv
		@html path / /index.html
		header @html Cache-Control "no-cache"
		file_server
	}
}
